{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MatXformResult",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "request_identity", "request_id", "batch_id", "result_status", "effect_state", "artifact_count", "artifacts", "timings"],
  "properties": {
    "contract_version": { "const": "ts-mat-xform-result/v1" },
    "request_identity": { "$ref": "#/$defs/sha256" },
    "request_id": { "type": "string", "minLength": 1 }, "batch_id": { "type": "string", "minLength": 1 },
    "result_status": { "enum": ["PASS", "BLOCKED", "FAIL", "UNAVAILABLE"] },
    "effect_state": { "enum": ["NONE", "CONFIRMED", "UNKNOWN"] },
    "artifact_count": { "type": "integer", "minimum": 0 }, "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "timings": { "type": "object", "additionalProperties": false, "required": ["validation_ms", "materialization_ms", "total_ms"], "properties": { "validation_ms": { "type": "number", "minimum": 0 }, "materialization_ms": { "type": "number", "minimum": 0 }, "total_ms": { "type": "number", "minimum": 0 } } },
    "error": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "type": "string", "minLength": 1 }, "message": { "type": "string", "minLength": 1 } } }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "artifact": { "type": "object", "additionalProperties": false, "required": ["artifact_id", "relative_path", "bytes", "sha256"], "properties": { "artifact_id": { "type": "string", "minLength": 1 }, "relative_path": { "type": "string", "minLength": 1 }, "bytes": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/sha256" } } } }
}
