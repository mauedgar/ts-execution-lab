{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-request-v0.schema.json",
  "title": "ts-execution-request/v0",
  "type": "object",
  "required": [
    "schema",
    "request_id",
    "Product_ref",
    "Product_operation_ref",
    "ExecutionAttempt_ref",
    "execution_profile_ref",
    "subject_ref",
    "context_id",
    "input",
    "binding"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "ts-execution-request/v0" },
    "request_id": { "type": "string", "minLength": 1 },
    "Product_ref": { "type": "string", "minLength": 1 },
    "Product_operation_ref": { "type": "string", "minLength": 1 },
    "ExecutionAttempt_ref": { "type": "string", "minLength": 1 },
    "execution_profile_ref": { "type": "string", "minLength": 1 },
    "subject_ref": { "type": "string", "minLength": 1 },
    "context_id": { "type": "string", "minLength": 1 },
    "input": { "type": "object" },
    "binding": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": { "enum": ["local-commander", "github-actions"] },
        "repository": { "type": "string" },
        "workflow": { "type": "string" },
        "ref": { "type": "string" }
      }
    }
  }
}
